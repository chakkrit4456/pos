# FlexPOS Cloud (web dashboard + POS sync) for the vendor or a store's own server.
FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN corepack enable
COPY . .
RUN ELECTRON_SKIP_BINARY_DOWNLOAD=1 pnpm install --frozen-lockfile && pnpm --filter @flexpos/cloud-web build && pnpm --filter @flexpos/cloud build

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production TZ=Asia/Bangkok HOST=0.0.0.0 PORT=4200 FLEXPOS_CLOUD_DATA=/data
COPY --from=build /app/apps/cloud/dist /app
RUN echo '{"name":"flexpos-cloud-runtime","private":true,"type":"module"}' > package.json && npm install --omit=dev --no-audit --no-fund pg@8 @node-rs/argon2@2 @electric-sql/pglite@0.3 && npm cache clean --force
VOLUME /data
EXPOSE 4200
HEALTHCHECK CMD node -e "fetch('http://localhost:4200/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "/app/main.js"]
